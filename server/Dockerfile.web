# 陪诊小暖 - 前端构建 + 静态托管（多阶段：node 构建 -> nginx 托管并反代后端）
FROM node:20-alpine AS build
WORKDIR /src
COPY voice-call/package.json /src/package.json
RUN npm install
COPY voice-call/ /src/
RUN npm run build

FROM nginx:1.27-alpine
COPY server/nginx.docker.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /var/www/xiaonuan
