# ============ 陪诊小暖 环境变量 ============
# 复制为 .env 后填入真实密钥（docker compose 会自动读取本文件）。
# 密钥只放在服务端，禁止写入前端或 APK。

# ---- MiMo：通用聊天、自动档案整理、药品图片理解 ----
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_LLM_MODEL=mimo-v2.6-flash
MIMO_VISION_MODEL=mimo-v2.6-flash

# ---- 豆包实时全双工语音（密钥只能放在服务端，禁止写入前端或 APK）----
DOUBAO_REALTIME_API_KEY=

# ---- 豆包语音「音频生成 HTTP」(TTS)：固定文本的系统播报（欢迎语/用药提醒/拍照复述等）走这里，
#      不占用实时全双工会话。密钥默认复用 DOUBAO_REALTIME_API_KEY。
# 注意：实时对话用的 zh_female_xiaohe_jupiter_bigtts 属于另一套未开通的资源，无法经 HTTP TTS 调用；
#      故默认用 seed-tts-2.0 下本账号可用的 zh_female_vv_uranus_bigtts，可用下方变量改音色。----
# DOUBAO_TTS_API_KEY=          # 留空则复用 DOUBAO_REALTIME_API_KEY
# DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts  # 须为 seed-tts-2.0 资源下已开通的音色

# ---- 后端 API 网关（用于访问 MiMo / 其他模型能力）----
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# ---- Coze 平台（如用到相关集成）----
COZE_API_BASE=https://api.coze.cn

# ---- 数据库（服务端 PostgreSQL）----
# 本地直跑后端时：POSTGRES_HOST=127.0.0.1
# Docker 部署时：保持默认，compose 会自动把 POSTGRES_HOST 设为 postgres 服务名
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=xiaonuan
POSTGRES_PASSWORD=
POSTGRES_DB=xiaonuan

# ---- 语音中继自指代后端地址 ----
# 本地直跑：http://127.0.0.1:8000/companion
# Docker 部署：保持默认，compose 已设为 http://api:8000/companion
COMPANION_URL=http://127.0.0.1:8000/companion

# ---- 语音中继监听端口（Docker 内默认 8081，无需改动）----
REALTIME_PORT=8081

# ---- Web 端口（docker compose 映射到主机的端口，默认 8080）----
WEB_PORT=8080
